# Safety: collapse accidental double language prefixes
/en/en/*                 /en/:splat                301!
/de/de/*                 /de/:splat                301!
/it/it/*                 /it/:splat                301!

# Assets, media and data should always come from the real folders
/en/assets/*              /assets/:splat            301!
/de/assets/*              /assets/:splat            301!
/it/assets/*              /assets/:splat            301!

/en/media/*               /media/:splat             301!
/de/media/*               /media/:splat             301!
/it/media/*               /media/:splat             301!

/en/data/*                /data/:splat              301!
/de/data/*                /data/:splat              301!
/it/data/*                /data/:splat              301!

# Fix relative .html links that resolve under the language prefix
/en/index.html            /en                       301!
/de/index.html            /de                       301!
/it/index.html            /it                       301!

/en/experiences.html      /en/experiences           301!
/de/experiences.html      /de/experiences           301!
/it/experiences.html      /it/experiences           301!

/en/philosophy.html       /en/philosophy            301!
/de/philosophy.html       /de/philosophy            301!
/it/philosophy.html       /it/philosophy            301!

/en/impressum.html        /en/impressum             301!
/de/impressum.html        /de/impressum             301!
/it/impressum.html        /it/impressum             301!

/en/datenschutz.html      /en/datenschutz           301!
/de/datenschutz.html      /de/datenschutz           301!
/it/datenschutz.html      /it/datenschutz           301!

/en/agb.html              /en/agb                   301!
/de/agb.html              /de/agb                   301!
/it/agb.html              /it/agb                   301!

# Language home pages
/en                       /index.html               200
/en/                      /index.html               200
/de                       /index.html               200
/de/                      /index.html               200
/it                       /index.html               200
/it/                      /index.html               200

# Root pages stored in repo root
/en/experiences           /experiences.html         200
/de/experiences           /experiences.html         200
/it/experiences           /experiences.html         200

/en/philosophy            /philosophy.html          200
/de/philosophy            /philosophy.html          200
/it/philosophy            /philosophy.html          200

/en/impressum             /impressum.html           200
/de/impressum             /impressum.html           200
/it/impressum             /impressum.html           200

/en/datenschutz           /datenschutz.html         200
/de/datenschutz           /datenschutz.html         200
/it/datenschutz           /datenschutz.html         200

/en/agb                   /agb.html                 200
/de/agb                   /agb.html                 200
/it/agb                   /agb.html                 200

# Everything else comes from pages/<slug>.html
/en/*                     /pages/:splat.html        200
/de/*                     /pages/:splat.html        200
/it/*                     /pages/:splat.html        200
